<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notarization requires the hardened runtime, which blocks microphone
         access unless the app asks for it here. Meeting mode's system audio
         tap is covered by the same entitlement. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Lets the app send Apple Events when pasting dictated text. -->
    <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
